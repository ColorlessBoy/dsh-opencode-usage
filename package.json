{
  "name": "dsh-opencode-usage",
  "version": "0.1.0",
  "private": true,
  "description": "OpenCode Go quota readout for the DeepSeek Harness Web GUI composer dock",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ColorlessBoy/dsh-opencode-usage.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "opencode",
    "opencode-go",
    "quota",
    "composer-dock"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
